        <field name="SpellSuccess" type="StringTableFieldDefinition" value="IF(HasStatus('ESC_QI_MODE',context.Source) and (HasPassive('ESC_P_Branch_taixuan',context.Source) or HasPassive('ESC_P_Branch_xueyan',context.Source)) and not HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(2d6+WisdomModifier,Necrotic,Magical);IF(HasStatus('ESC_QI_MODE',context.Source) and (HasPassive('ESC_P_Branch_taixuan',context.Source) or HasPassive('ESC_P_Branch_xueyan',context.Source)) and HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(2d6+WisdomModifier,Force,Magical);IF(not (HasStatus('ESC_QI_MODE',context.Source) and (HasPassive('ESC_P_Branch_taixuan',context.Source) or HasPassive('ESC_P_Branch_xueyan',context.Source)))):DealDamage(OffhandMeleeWeapon,OffhandMeleeWeaponDamageType,Magical);IF(not HasPassive('ESC_P_Level5',context.Source) and not HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(2d6,Necrotic,Magical);IF(not HasPassive('ESC_P_Level5',context.Source) and HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(2d6,Force,Magical);IF(HasPassive('ESC_P_Level5',context.Source) and not HasPassive('ESC_P_Level10',context.Source) and not HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(3d6,Necrotic,Magical);IF(HasPassive('ESC_P_Level5',context.Source) and not HasPassive('ESC_P_Level10',context.Source) and HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(3d6,Force,Magical);IF(HasPassive('ESC_P_Level10',context.Source) and not HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(4d6,Necrotic,Magical);IF(HasPassive('ESC_P_Level10',context.Source) and HasStatus('ESC_FORCE_MODE',context.Source)):DealDamage(4d6,Force,Magical);ApplyStatus(ESC_HIT_MARKER,100,0);IF(not (HasStatus('ESC_QI_MODE',context.Source) and (HasPassive('ESC_P_Branch_taixuan',context.Source) or HasPassive('ESC_P_Branch_xueyan',context.Source)))):ExecuteWeaponFunctors(OffHand)" />
