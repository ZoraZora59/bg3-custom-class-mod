        <field name="StatsFunctorContext" type="EnumerationListTableFieldDefinition" enumeration_type_name="StatsFunctorContext" value="OnCast;OnStatusRemoved" />
        <field name="Conditions" type="StringTableFieldDefinition" value="(context.HasContextFlag(StatsFunctorContext.OnCast) and (SpellId('Projectile_ESC_yujian') or SpellId('Target_ESC_sword_strike') or SpellId('Shout_ESC_tiaoxi') or SpellId('Projectile_ESC_taixuan_zhaoxi') or SpellId('Target_ESC_taixuan_jiuxiao') or SpellId('Projectile_ESC_taixuan_liuguang') or SpellId('Shout_ESC_taixuan_xinghe') or SpellId('Shout_ESC_taixuan_taiqing') or SpellId('Zone_ESC_taixuan_yixiantian') or SpellId('Zone_ESC_tianqing_nifeng') or SpellId('Target_ESC_tianqing_wanjun') or SpellId('Target_ESC_tianqing_lietian')) and HasUseCosts('ActionPoint',true) and not Tagged('EXTRA_ATTACK_BLOCKED',context.Source) and (not HasShieldEquipped(context.Source) and ((not HasPassive('ESC_P_Branch_taixuan',context.Source) and not HasPassive('ESC_P_Branch_xingge',context.Source)) or (not HasHeavyArmor(context.Source) and not HasMediumArmor(context.Source))))) or (context.HasContextFlag(StatsFunctorContext.OnStatusRemoved) and StatusId('ESC_INITIAL_SWORD_ATTACK') and TurnBased() and not Dead() and HasPassive('ESC_P_Level5',context.Target) and not HasStatus('ESC_INITIAL_SWORD_ATTACK',context.Target) and not HasStatus('ESC_EXTRA_ATTACK',context.Target) and not Tagged('EXTRA_ATTACK_BLOCKED',context.Target) and (not HasShieldEquipped(context.Target) and ((not HasPassive('ESC_P_Branch_taixuan',context.Target) and not HasPassive('ESC_P_Branch_xingge',context.Target)) or (not HasHeavyArmor(context.Target) and not HasMediumArmor(context.Target)))))" />
        <field name="StatsFunctors" type="FunctorsTableFieldDefinition" value="IF(context.HasContextFlag(StatsFunctorContext.OnCast) and TurnBased(context.Source)):UseActionResource(SELF,ESC_SwordOpportunity,100%,0);IF(context.HasContextFlag(StatsFunctorContext.OnCast) and TurnBased(context.Source) and HasPassive('ESC_P_Branch_xingge',context.Source)):RestoreResource(SELF,ESC_SwordOpportunity,1,0);IF(context.HasContextFlag(StatsFunctorContext.OnCast) and TurnBased(context.Source) and not HasPassive('ESC_P_Branch_xingge',context.Source) and not HasPassive('ESC_P_Level10',context.Source)):RestoreResource(SELF,ESC_SwordOpportunity,2,0);IF(context.HasContextFlag(StatsFunctorContext.OnCast) and TurnBased(context.Source) and not HasPassive('ESC_P_Branch_xingge',context.Source) and HasPassive('ESC_P_Level10',context.Source)):RestoreResource(SELF,ESC_SwordOpportunity,3,0);IF(context.HasContextFlag(StatsFunctorContext.OnCast) and TurnBased(context.Source)):ApplyStatus(SELF,ESC_EXTRA_ATTACK,100,1);IF(context.HasContextFlag(StatsFunctorContext.OnCast) and not TurnBased(context.Source)):ApplyStatus(SELF,ESC_INITIAL_SWORD_ATTACK,100,1);IF(context.HasContextFlag(StatsFunctorContext.OnStatusRemoved)):UseActionResource(ESC_SwordOpportunity,100%,0);IF(context.HasContextFlag(StatsFunctorContext.OnStatusRemoved) and HasPassive('ESC_P_Branch_xingge',context.Target)):RestoreResource(ESC_SwordOpportunity,1,0);IF(context.HasContextFlag(StatsFunctorContext.OnStatusRemoved) and not HasPassive('ESC_P_Branch_xingge',context.Target) and not HasPassive('ESC_P_Level10',context.Target)):RestoreResource(ESC_SwordOpportunity,2,0);IF(context.HasContextFlag(StatsFunctorContext.OnStatusRemoved) and not HasPassive('ESC_P_Branch_xingge',context.Target) and HasPassive('ESC_P_Level10',context.Target)):RestoreResource(ESC_SwordOpportunity,3,0);IF(context.HasContextFlag(StatsFunctorContext.OnStatusRemoved)):ApplyStatus(ESC_EXTRA_ATTACK,100,1)" />
      </fields>
